// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Google_login {
  id                Int      @id @default(autoincrement())
  userId            Int
  email             String? @db.Text
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cus_users Cus_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Line_login {
  id                Int      @id @default(autoincrement())
  lineUserId        Int
  username          String

  cus_user  Cus_users @relation(fields: [lineUserId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  cus_users Cus_users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cus_users {
  id            Int        @id @default(autoincrement())
  citizenType   CitizenType?
  citizenNumber String?    @unique
  studentId     String?    @unique
  gender        GenderType?
  titleName     String?
  name          String?
  name_th       String?
  name_en       String?
  email         String     @unique @db.VarChar(191)
  // password      String?
  // religion      String?
  mobilePhone   String?
  birthDate     DateTime?
  isScholarshipStudent  Boolean? @default(false)
  isDisabled            Boolean? @default(false)
  faculty_department    String?
  // faculty    String?
  // department String?
  // tu_status  String?
  lifestyle     Json? // เก็บเป็น JSON string เช่น '["NIGHT_OWL", "QUIET", "LGBTQ_FRIENDLY"]'
  lifestyleNote String?
  isEnabled     Boolean @default(true) // สถานะการใช้งาน (เผื่อลาออก หรือระงับสิทธิ์ชั่วคราว)

  address       Address[]
  guardians     Guardian[]
  profileImage  File_info[]
  vehicleInfo   Vehicle?

  role          Role      @default(STUDENT)
  bookings      Booking[]

  emailVerified   DateTime?
  googleAccounts  Google_login[]
  line_logins     Line_login[]
  sessions        Session[]
  logs            cus_users_log[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model cus_users_log {
  id        Int           @id @default(autoincrement())
  userId    Int
  cus_users      Cus_users    @relation(fields: [userId], references: [id])

  action    String // เช่น "CREATE", "UPDATE", "DELETE"
  details   Json?  // รายละเอียดเพิ่มเติม เช่น ข้อมูลที่ถูกเปลี่ยนแปลง

  createdAt DateTime @default(now())
}

enum CitizenType {
  CITIZEN_ID
  PASSPORT
  OTHER
}

enum GenderType {
  MALE
  FEMALE
  LGBTQ
  OTHER
}

model Guardian {
  id       Int       @id @default(autoincrement())
  userId   Int
  cus_users     Cus_users      @relation(fields: [userId], references: [id])
  name     String
  relation String
  phone    String
  address  Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File_info {
  id     Int  @id @default(autoincrement())
  createdBy Int
  cus_users   Cus_users @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  type   FileType // Enum: CITIZEN_CARD, FACE_PHOTO, VEHICLE_PHOTO
  path   String
  // extension String
  isEnabled Boolean @default(true)

  booking_logs Booking_log[]

  createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}

enum FileType {
  FACE_PHOTO
  CITIZEN_CARD
  VEHICLE_CARD
  VEHICLE_PHOTO
}

model Vehicle {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  cus_users   Cus_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  // type         VehicleType   // ประเภทรถ เช่น รถยนต์, มอเตอร์ไซค์
  // brand        String
  // model        String
  // color        String

  licensePlate String @unique // หมายเลขป้ายทะเบียน
  province     String // จังหวัดบนป้ายทะเบียน
  ownerName    String // ชื่อผู้ครอบครองรถ (เผื่อเป็นชื่อพ่อแม่ ไม่ใช่ชื่อนศ.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleType {
  CAR
  MOTORCYCLE
  BICYCLE
  OTHER
}

model Address {
  id     Int  @id @default(autoincrement())
  userId Int
  cus_users   Cus_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          AddressType // Enum: REGISTERED (ตามทะเบียนบ้าน), CURRENT (ปัจจุบัน)
  addressDetail String // เลขที่บ้าน, ถนน, ซอย
  subDistrict   String
  district      String
  province      String
  postalCode    String
  country       String      @default("Thailand")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  guardian   Guardian? @relation(fields: [guardianId], references: [id])
  guardianId Int?
}

enum AddressType {
  REGISTERED
  CURRENT
}

model Campus {
  id   Int    @id @default(autoincrement())
  name String @unique
  dorm Dorm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dorm {
  id      Int        @id @default(autoincrement())
  name    String     @unique
  genderType  GenderType @default(OTHER)
  mapUrl  String
  maxCols Int        @default(15) // จำนวนคอลัมน์ของแผนผัง
  maxRows Int        @default(25) // จำนวนแถวของแผนผัง
  campusId  Int
  campus    Campus       @relation(fields: [campusId], references: [id])
  // floors  Json       @default("[]")
  availableRooms Int @default(0)
  rooms   Room[]

  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}

model Room {
  id               Int        @id @default(autoincrement())
  roomId           String     //@unique ไม่ได้เพราะ มีห้อง M1-COMMON , TOILET, WASH, ELEVATOR ที่ซ้ำกันในแต่ละ Zone
  floor            Int
  // zone            String
  dormId           Int
  dorm             Dorm       @relation(fields: [dormId], references: [id])
  // isAvailable      Boolean    @default(true)
  status           RoomStatus @default(AVAILABLE)
  isLocked         Boolean    @default(false)
  roomType         RoomType   @default(AC_PRIVATE_BATHROOM)
  price            Float      @default(0.0)
  capacity         Int        @default(2)
  currentOccupancy Int        @default(0)
  lifestyleConfig  Json? // คนแรกที่จองจะมา Set ค่าที่นี่ไว้ เช่น '["NIGHT_OWL", "QUIET", "LGBTQ_FRIENDLY"]' เพื่อให้คนที่จองต่อไปต้องมี Lifestyle ที่เข้ากัน
  lifestyleNote    String?
  facultyConfig    Json?
  
  // --- เพื่อรองรับ Zone B ---
  isSuite          Boolean      @default(false) // ระบุว่าเป็นห้องใหญ่ หรือไม่
  parentId         Int?         // ชี้ไปที่ ID ของห้องใหญ่ (สำหรับห้องย่อย A, B)
  parent           Room?        @relation("RoomToSubRoom", fields: [parentId], references: [id])
  subRooms         Room[]       @relation("RoomToSubRoom")
  
  booking          Booking[]
  posX             Int @default(1)
  posY             Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RoomType {
  AC_PRIVATE_BATHROOM // แอร์ + ห้องน้ำในตัว
  AC_SHARED_BATHROOM // แอร์ + ห้องน้ำรวม
  FAN_PRIVATE_BATHROOM // พัดลม + ห้องน้ำในตัว
  FAN_SHARED_BATHROOM // พัดลม + ห้องน้ำรวม
  COMMON_ROOM // ห้องกลาง อ่านนส.
  TOILET // ห้องน้ำ
  WASH // อ่างล้างจาน
  ELEVATOR // ลิฟต์
  SECRET // ห้องลับ ห้องอะไรก็ไม่รู้
}

enum RoomStatus {
  AVAILABLE
  PENDING
  FULL
  MAINTENANCE
  COMMON
}

model Booking {
  id        Int           @id @default(autoincrement())
  userId    Int
  cus_users      Cus_users          @relation(fields: [userId], references: [id])
  roomId    Int
  room      Room          @relation(fields: [roomId], references: [id])
  status    BookingStatus @default(PENDING)
  type      BookingType   @default(NOT_CHARTER)
  groupId   String? // รหัสกลุ่ม (กรณีจองเหมาห้อง)

  booking_logs Booking_log[]
  payments     Payment[]

  @@index([userId])
  @@index([roomId])
}

model Booking_log {
  id        Int           @id @default(autoincrement())
  bookingId Int
  booking      Booking          @relation(fields: [bookingId], references: [id])

  status    BookingStatus @default(PENDING)
  file      File_info[]
  // expiresAt DateTime? // เวลาที่การจองนี้จะหมดอายุ (ถ้ายังไม่ชำระเงิน)

  paymentProof String? // URL ของรูปภาพสลิป หรือเอกสาร
  verifiedBy   Int? // ID ของ Admin ที่เป็นคนกดอนุมัติ
  verifier     Staff_users?    @relation("AdminVerifications", fields: [verifiedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING // รอชำระเงิน (Hold ที่ไว้ 10 นาที)
  COMPLETED // ผ่านการตรวจสอบแล้ว
  CANCELLED // ยกเลิก
  EXPIRED // หมดเวลา (ถ้าไม่ชำระเงินภายใน 10 นาที)
  VERIFYING // ชำระเงินเรียบร้อย และรอการตรวจสอบการชำระเงิน
  REJECTED // การชำระเงินถูกปฏิเสธ หรือเจ้าหน้าที่ปฏิเสธ
  PENDING_CORRECTION // กำลังรอการแก้ไข
}

enum BookingType {
  CHARTER // เหมาห้อง
  NOT_CHARTER // ไม่เหมาห้อง (จองรายคน)
  CO_RESIDENT // จองแบบอยู่ร่วม
}

model Payment {
  id             String        @id @default(uuid()) // ใช้ UUID เพื่อความปลอดภัยในการส่งค่าไป Gateway
  bookingId      Int
  booking        Booking       @relation(fields: [bookingId], references: [id])
  
  amount         Decimal       // จำนวนเงินมัดจำ
  currency       String        @default("THB")
  
  status         PaymentStatus @default(PENDING)
  method         String        @default("PROMPTPAY") // เก็บไว้เผื่ออนาคตรองรับ Credit Card
  
  // ข้อมูลจาก Gateway (สำคัญมากสำหรับตรวจสอบ)
  external_id    String?       @unique // เช่น Charge ID จาก Omise หรือ Reference No. จากธนาคาร
  qr_payload     String?       @db.Text // เก็บข้อมูลที่ใช้เจน QR Code
  
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookingId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum Role {
  STUDENT
  ADMIN
}

model Staff_users {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  password      String

  titleName     String?
  name          String?
  phone         String?
  profileImage  String?

  role          Role    @default(ADMIN)
  employeeId    String?  @unique
  department    String?
  // level         Int     @default(1)
  isEnabled     Boolean @default(true)

  lastLogin     DateTime?

  booking_logs Booking_log[] @relation("AdminVerifications")
  staff_action_log Staff_action_log[]

  createdAt     DateTime @default(now())
  // updatedAt     DateTime @updatedAt
}

model Staff_action_log {
  id        Int           @id @default(autoincrement())
  verifiedBy   Int
  staff     Staff_users    @relation(fields: [verifiedBy], references: [id])

  // verified_logs
  // เชื่อมกลับไปที่ Booking_log เพื่อดูว่า Admin คนนี้อนุมัติรายการไหนบ้าง
  // booking_log    booking_log[] @relation("AdminVerifications")

  // paymentProof String? // URL ของรูปภาพสลิป หรือเอกสาร
  
  // verifiedBy   Int? // ID ของ Admin ที่เป็นคนกดอนุมัติ
  // verifier     Staff_users?    @relation("AdminVerifications", fields: [verifiedBy], references: [id])
  
  remark  String? // หมายเหตุจาก Admin (กรณีปฏิเสธการจอง)
  // verifiedAt   DateTime?

  createdAt DateTime @default(now())
}
