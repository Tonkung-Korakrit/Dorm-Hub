model User {
  id            Int        @id @default(autoincrement())
  citizenType   String?
  citizenNumber String?    @unique
  studentId     String    @unique
  gender        GenderType?
  prefix        String?
  name          String?
  name_en       String
  name_th       String
  birthDate     DateTime?
  phone         String?
  email         String     @unique @db.VarChar(191) // ป้องกันปัญหา key ยาว
  isScholarshipStudent  Boolean? @default(false)
  isDisabled            Boolean? @default(false)
  address       Address[]

  image      String?
  faculty_department    String?
  //   facultyId  Int
  //   faculty    Faculty @relation(fields: [facultyId], references: [id])
  // faculty    String?
  // department String?
  tu_status  String?
  lifestyle  Json? // เก็บเป็น JSON string เช่น '["NIGHT_OWL", "QUIET", "LGBTQ_FRIENDLY"]'

  guardians   Guardian[]
  documents   UserDocument[]
  vehicleInfo Vehicle?

  role     Role      @default(STUDENT)
  bookings Booking[]

  emailVerified DateTime?
  accounts      Account[]
  // sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GenderType {
  MALE // หอชาย
  FEMALE // หอหญิง
  LGBTQ // หอรวม (แยกชั้น หรือแยกฝั่ง)
  OTHER // อื่นๆ
}

model Guardian {
  id       Int       @id @default(autoincrement())
  userId   Int
  user     User      @relation(fields: [userId], references: [id])
  name     String
  relation String
  phone    String
  address  Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDocument {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   DocType // Enum: CITIZEN_CARD, FACE_PHOTO, VEHICLE_PHOTO
  url    String // ลิงก์ไปยัง Cloud Storage (เช่น S3, Supabase Storage)
  status String  @default("PENDING") // VERIFIED, REJECTED

  createdAt DateTime @default(now())
}

enum DocType {
  FACE_PHOTO
  CITIZEN_CARD
  VEHICLE_CARD
  VEHICLE_PHOTO
}

model Vehicle {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // type         VehicleType   // ประเภทรถ เช่น รถยนต์, มอเตอร์ไซค์
  // brand        String
  // model        String
  // color        String

  licensePlate String @unique // หมายเลขป้ายทะเบียน
  province     String // จังหวัดบนป้ายทะเบียน
  ownerName    String // ชื่อผู้ครอบครองรถ (เผื่อเป็นชื่อพ่อแม่ ไม่ใช่ชื่อนศ.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleType {
  CAR
  MOTORCYCLE
  BICYCLE
  OTHER
}

model Address {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          AddressType // Enum: REGISTERED (ตามทะเบียนบ้าน), CURRENT (ปัจจุบัน)
  addressDetail String // เลขที่บ้าน, ถนน, ซอย
  subDistrict   String
  district      String
  province      String
  postalCode    String
  country       String      @default("Thailand")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  guardian   Guardian? @relation(fields: [guardianId], references: [id])
  guardianId Int?
}

enum AddressType {
  REGISTERED
  CURRENT
}

model Dorm {
  id   Int    @id @default(autoincrement())
  name String
  zone Zone[]

  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}

model Zone {
  id      Int        @id @default(autoincrement())
  name    String // เช่น "B", "C", "F5"
  gender  GenderType @default(OTHER)
  mapUrl  String // ลิงก์ Google Map
  maxCols Int        @default(15) // จำนวนคอลัมน์ของแผนผัง
  maxRows Int        @default(25) // จำนวนแถวของแผนผัง
  dorm    Dorm       @relation(fields: [dormId], references: [id])
  dormId  Int
  rooms   Room[]

  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}

model Room {
  id               Int        @id @default(autoincrement())
  roomId           String
  // roomNumber           String
  floor            Int
  zone             Zone       @relation(fields: [zoneId], references: [id])
  zoneId           Int
  // available Boolean  @default(true)
  status           RoomStatus @default(AVAILABLE)
  isLocked         Boolean    @default(false) // สำหรับ Admin ล็อกห้องไม่ให้จอง (กรณีซ่อมแซม)
  roomType         RoomType   @default(AC_PRIVATE_BATHROOM) // เช่น "Single", "Double", "Triple"
  price            Float      @default(0.0)
  capacity         Int        @default(2) // รองรับกี่คน (เช่น ห้องคู่ ห้องเดี่ยว)
  currentOccupancy Int        @default(0) // (จำนวนคนที่พักอยู่ตอนนี้)
  lifestyleConfig  Json? // คนแรกที่จองจะมา Set ค่าที่นี่ไว้ lgbtqFriendly 
  // dormId   Int // ไอดี หอที่ภูมิภาคไหน
  // dorm     Dorm     @relation(fields: [dormId], references: [id]) // หอที่ภูมิภาคไหน
  booking          Booking[]

  posX Int @default(1)
  posY Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RoomType {
  AC_PRIVATE_BATHROOM // แอร์ + ห้องน้ำในตัว
  AC_SHARED_BATHROOM // แอร์ + ห้องน้ำรวม
  FAN_PRIVATE_BATHROOM // พัดลม + ห้องน้ำในตัว
  FAN_SHARED_BATHROOM // พัดลม + ห้องน้ำรวม
}

enum RoomStatus {
  AVAILABLE
  PENDING
  FULL
  MAINTENANCE
}

model Booking {
  id        Int           @id @default(autoincrement())
  // id       String   @id @default(cuid())
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  roomId    Int //@unique
  room      Room          @relation(fields: [roomId], references: [id])
  status    BookingStatus @default(PENDING)
  type      BookingType   @default(NOT_CHARTER)
  groupId   String? // รหัสกลุ่ม (กรณีจองเหมาห้อง)
  expiresAt DateTime?

  paymentProof String? // URL ของรูปภาพสลิป หรือเอกสาร
  adminRemark  String? // หมายเหตุจาก Admin (กรณีปฏิเสธการจอง)
  verifiedBy   Int? // ID ของ Admin ที่เป็นคนกดอนุมัติ
  verifier     Admin?    @relation("AdminVerifications", fields: [verifiedBy], references: [id])
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([roomId])
}

enum BookingStatus {
  PENDING // รอชำระเงิน (Hold ที่ไว้ 10 นาที)
  COMPLETED // ชำระเงินเรียบร้อย
  CANCELLED // ยกเลิก หรือ หมดเวลาชำระเงิน
  EXPIRED // หมดเวลา (ถ้าไม่ชำระเงินภายใน 10 นาที)
  VERIFYING // รอการตรวจสอบการชำระเงิน
  REJECTED // การชำระเงินถูกปฏิเสธ
}

enum BookingType {
  CHARTER // เหมาห้อง
  NOT_CHARTER // ไม่เหมาห้อง (จองรายคน)
  CO_RESIDENT // จองแบบอยู่ร่วม
}

enum Role {
  STUDENT
  ADMIN
}

model Admin {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String

  name  String?
  phone String?
  image String? // โปรไฟล์รูปภาพสำหรับหน้า Dashboard

  role       Role    @default(ADMIN) // ปรับ Default ให้เป็น ADMIN
  employeeId String?  @unique
  department String?
  level      Int     @default(1)

  isActive Boolean @default(true) // สถานะการใช้งาน (เผื่อลาออก หรือระงับสิทธิ์ชั่วคราว)

  lastLogin DateTime? // ตรวจสอบความปลอดภัย (Audit Trail)

  // เชื่อมกลับไปที่ Booking เพื่อดูว่า Admin คนนี้อนุมัติรายการไหนบ้าง
  verifiedBookings Booking[] @relation("AdminVerifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
